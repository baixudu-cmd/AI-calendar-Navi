<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.navi-calendar.proactive-reminder</string>
  <key>WorkingDirectory</key>
  <string>__NAVI_PROJECT_ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__NAVI_PROJECT_ROOT__/scripts/run-proactive-launchagent.sh reminder</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__NAVI_PROJECT_ROOT__/logs/proactive-reminder.out.log</string>
  <key>StandardErrorPath</key>
  <string>__NAVI_PROJECT_ROOT__/logs/proactive-reminder.err.log</string>
</dict>
</plist>

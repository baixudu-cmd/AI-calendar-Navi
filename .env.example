# 本文件只放占位变量。真实密钥放本机 .env 或系统安全环境，不提交。

APP_NAME=minical-agent
TIMEZONE=Asia/Shanghai
# 非密钥产品设置默认从 config/settings.local.json 读取；也可显式指定。
# NAVI_SETTINGS_FILE=config/settings.local.json

MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# live bring-up 必须配置专用测试日历 ID，不能使用 primary；两个值必须一致。
FEISHU_CALENDAR_ID=
FEISHU_TEST_CALENDAR_ID=
# 主日历只供显式 smoke 使用，不能等于测试日历 ID。
FEISHU_MAIN_CALENDAR_ID=

OPENCLAW_WORKSPACE=
WECHAT_ENTRY_SECRET=
